# Keep the build context minimal and ensure no secrets or local state are baked
# into the image. The per-user EIA_API_KEY is injected at runtime, never copied.

.env
*.env
.env.*
secrets/
.databricks

.venv/
**/__pycache__/
*.pyc

.git/
.gitignore
.dockerignore

docs/
tests/
scripts/
eval/

*.md
!README.md
